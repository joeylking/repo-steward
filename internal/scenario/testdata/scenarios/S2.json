{
  "name": "S2",
  "fixture": "breaking-minor",
  "description": "Minor upgrade changes a signature; the agent repairs the single call site.",
  "expected": "proposal_prepared",
  "steps": [
    {
      "tool": "list_candidates"
    },
    {
      "tool": "apply_upgrade",
      "args": {
        "module": "example.com/lib",
        "version": "v1.3.0"
      }
    },
    {
      "tool": "run_validation",
      "reason": "Find out what broke."
    },
    {
      "tool": "read_file",
      "args": {
        "path": "main.go"
      },
      "reason": "Inspect the failing call site."
    },
    {
      "tool": "read_dependency_source",
      "args": {
        "module": "example.com/lib",
        "version": "v1.3.0",
        "path": "lib.go"
      },
      "reason": "Read the new signature."
    },
    {
      "tool": "write_file",
      "args": {
        "path": "main.go",
        "content": "package main\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\n\t\"example.com/lib\"\n)\n\n// greeting wraps the library call so tests do not depend on its signature.\nfunc greeting(name string) string {\n\treturn lib.Greet(context.Background(), name)\n}\n\nfunc main() {\n\tfmt.Println(greeting(\"steward\"))\n}\n"
      },
      "reason": "Pass a context to Greet."
    },
    {
      "tool": "run_validation",
      "reason": "Confirm the repair."
    },
    {
      "tool": "normalize_manifests"
    },
    {
      "tool": "run_validation"
    },
    {
      "tool": "prepare_proposal",
      "args": {
        "title": "Upgrade example.com/lib to v1.3.0",
        "summary": "Greet now takes a context. Updated the one call site in main.go to pass context.Background(). Build, vet, and tests pass."
      }
    }
  ],
  "allowed_files": [
    "go.mod",
    "go.sum",
    "main.go"
  ],
  "required_files": [
    "main.go"
  ],
  "oracles": [
    {
      "file": "main.go",
      "must_contain": [
        "lib.Greet(",
        "context.Background()"
      ],
      "must_not_contain": [
        "hello, "
      ]
    },
    {
      "file": "go.mod",
      "must_contain": [
        "example.com/lib v1.3.0"
      ]
    }
  ]
}
